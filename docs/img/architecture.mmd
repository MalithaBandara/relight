flowchart TB
  subgraph In["What arrives"]
    A["Calls and crew<br>voice reports"]
    B["SMS, chat, portal,<br>BD codes"]
    C["Photos and<br>drone clips"]
    D["SCADA lockouts,<br>smart meters"]
  end
  subgraph Meta["Meta Model API"]
    VT["Muse Voice Transcribe"]
    SAM["SAM 3.1"]
    SP["Muse Spark"]
  end
  A --> VT --> SP
  A -. "languages Voice<br>Transcribe lacks" .-> SP
  B --> SP
  C --> SAM --> SP
  SP -->|"structured reports, damage"| E["Engine: place on transformer, claim evidence"]
  D --> E
  E --> T["Fault tracer: likelihood search over the feeder"]
  T --> I["Incidents and priority"]
  I --> AG["Agent answers calls, asks questions,<br>sends updates: Spark words it,<br>code chooses the facts"]
  I --> CR["Agent dispatches crews,<br>replans the work"]
  AG --> P["Customers and field crews"]
  CR --> P
  P -. "answers, call-backs and<br>site reports feed back" .-> A
  I --> S["Switching plans,<br>safety-checked"]
  S -->|"operator approves"| O["Console"]
