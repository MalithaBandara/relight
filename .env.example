# Meta Model API key (https://dev.meta.ai). Leave empty to run in mock mode.
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
SAM_MODEL=sam-3.1
# Optional: OpenAI-compatible server running Muse Glimmer locally (vLLM / llama.cpp)
GLIMMER_BASE=http://localhost:8001/v1
GLIMMER_MODEL=muse-glimmer
