# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Secrets
.env
.env.*

# Local data (the model response cache in .cache/ is committed so a fresh clone replays the live runs)
*.sqlite3
*.db

# Node / frontend
node_modules/
dist/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
data/*.db
!.env.example

# Synthesised call-agent speech (regenerated on demand)
media/audio/tts/

# Third-party videos (not ours to redistribute; media/videos/CREDITS.md says how to fetch them) and portal uploads
media/drone/*.mp4
media/videos/*.mp4
media/uploads/

# Owner-machine API restriction (see relight/config.py api_allowed): the marker that switches it on, the one-turn
# permission file, and the local hooks that manage them. A fresh clone has none of these, so it is not restricted.
.claude/require_go
.claude/api_go
.claude/settings.local.json
media/overlays/

# agent skill installs (plugin copies, not part of Relight)
.agents/
agent/
data/skills/
.claude/skills/
skills-lock.json

# demo video build (Remotion project and renders)
/output/
/video/

